---
/**
 * Presentation Component: ActiveCameraViewport.astro
 * Unobstructed primary operator monitor for Camera 01 (local webcam).
 * Clean integrated header and operator control strip without floating overlays blocking video.
 */
import { DEFAULT_SIX_CAMERA_NODES } from '../domain';

const cam01 = DEFAULT_SIX_CAMERA_NODES[0];
---

<article
  class="camera-monitor camera-monitor-active"
  data-camera-id={cam01.camera_id}
  data-camera-status="ACTIVE"
>
  <header class="monitor-header">
    <div class="monitor-identity">
      <span class="tally-dot tally-live" id="cam01-pulse-led" aria-hidden="true"></span>
      <span class="monitor-code mono-stat">{cam01.camera_id}</span>
      <span class="monitor-zone">{cam01.location_zone}</span>
    </div>

    <div class="monitor-header-meta">
      <span class="monitor-state-live" id="cam01-operational-badge">En vivo</span>
      <span class="monitor-latency mono-stat" id="cam01-fps-counter">-- ms</span>
    </div>
  </header>

  <div class="monitor-stage active-stage" id="cam01-viewport-container">
    <video
      id="cam01-video"
      class="cctv-video-element"
      autoplay
      playsinline
      muted
      width="640"
      height="480"
    ></video>

    <canvas
      id="cam01-overlay-canvas"
      class="cctv-canvas-element"
      width="640"
      height="480"
      aria-label="Superposición de detección sobre el flujo de video en vivo"
    ></canvas>
  </div>

  <div class="monitor-live-strip" aria-live="polite">
    <div class="live-strip-primary">
      <strong class="live-diagnosis" id="hud-predicted-class">Conectando cámara...</strong>
      <span class="live-evidence-inline" id="hud-evidence-text">
        Esperando fotogramas del dispositivo local
      </span>
    </div>

    <div class="live-strip-metrics">
      <div class="inline-datum">
        <span class="datum-label">Sujeto</span>
        <span class="datum-value" id="hud-subject-gender">Sin detectar</span>
      </div>
      <div class="inline-datum">
        <span class="datum-label">Fotogramas</span>
        <span class="datum-value mono-stat" id="hud-frame-count">0</span>
      </div>
    </div>
  </div>

  <footer class="monitor-footer active-footer">
    <span class="monitor-source-info" id="cam01-source-description">
      Cámara local en {cam01.resolution}
    </span>

    <div class="monitor-controls">
      <button
        type="button"
        class="btn-monitor"
        id="btn-infer-once"
        title="Evaluar fotograma actual inmediatamente"
      >
        Capturar
      </button>
      <button
        type="button"
        class="btn-monitor btn-monitor-toggle"
        id="btn-toggle-loop"
        data-running="true"
      >
        Pausar
      </button>
      <button
        type="button"
        class="btn-monitor"
        id="btn-start-webcam"
        title="Reconectar cámara del dispositivo"
      >
        Reiniciar
      </button>
    </div>
  </footer>
</article>
