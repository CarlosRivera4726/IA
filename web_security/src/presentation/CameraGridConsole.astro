---
/**
 * Presentation Component: CameraGridConsole.astro
 * Central CCTV Matrix & Monitoring Console:
 * - 6-Camera Grid (CAM-01 Local Active + CAM-02..06 Server Standby)
 * - Live AI Telemetry Panel
 */
import { DEFAULT_SIX_CAMERA_NODES } from '../domain';
import ActiveCameraViewport from './ActiveCameraViewport.astro';
import DisabledServerCameraCard from './DisabledServerCameraCard.astro';
import ModelTelemetryPanel from './ModelTelemetryPanel.astro';

const disabledServerCameras = DEFAULT_SIX_CAMERA_NODES.filter(
  (node) => node.camera_id !== 'CAM-01'
);
---

<div class="console-workspace-layout">
  <!-- Columna principal: Matriz de 6 Cámaras -->
  <section class="cctv-matrix-section" aria-label="Matriz de 6 cámaras de seguridad">
    <div class="matrix-toolbar">
      <div class="matrix-title-group">
        <h2 class="matrix-heading">Matriz de Monitoreo CCTV</h2>
        <span class="matrix-badge-topology">6 Canales · 1 Activo / 5 En Espera</span>
      </div>

      <div class="matrix-actions">
        <button type="button" class="btn-matrix-action" id="btn-sync-cameras" title="Consultar estado de las 6 cámaras">
          Sincronizar Nodos
        </button>
      </div>
    </div>

    <!-- La Grilla de 6 Cámaras unificada -->
    <div class="cctv-six-grid" role="region" aria-label="Cuadrícula de cámaras">
      <!-- Canal 01: Cámara Local Activa (Dispositivo actual) -->
      <div class="cctv-grid-cell cell-active">
        <ActiveCameraViewport />
      </div>

      <!-- Canales 02 a 06: Cámaras Remotas en Servidor -->
      {disabledServerCameras.map((cameraNode) => (
        <div class="cctv-grid-cell cell-remote">
          <DisabledServerCameraCard node={cameraNode} />
        </div>
      ))}
    </div>
  </section>

  <!-- Columna lateral: Panel de Telemetría de IA -->
  <div class="console-sidebar-column">
    <ModelTelemetryPanel />
  </div>
</div>
