---
/**
 * Presentation Component: ModelTelemetryPanel.astro
 * High-density real-time telemetry panel for AI inference.
 * Displays predicted event, threat level, confidence, class probabilities, and live alert feed.
 */
import { CANONICAL_DETECTION_CLASSES, DETECTION_CLASS_CATALOG } from '../domain';
---

<aside class="telemetry-panel" aria-label="Telemetría de visión artificial">
  <header class="telemetry-header">
    <div class="telemetry-title-wrap">
      <h3 class="telemetry-title">Telemetría de IA</h3>
      <span class="telemetry-chip-ai" id="telemetry-model-name">Keras 3 + PyTorch CUDA</span>
    </div>
    <span class="telemetry-live-dot" title="Recibiendo datos continuos"></span>
  </header>

  <!-- Tarjeta de diagnóstico principal -->
  <div class="prediction-readout-card" id="prediction-readout-card" data-threat-level="LOW">
    <div class="readout-hero">
      <span class="readout-label">Evento en Cámara 01</span>
      <h4 class="readout-event-name" id="readout-readable-class">Iniciando...</h4>
      <span class="readout-key-tag mono-stat" id="readout-canonical-key">Escena_Normal</span>
    </div>

    <div class="readout-score-box">
      <span class="readout-score-title">Confianza</span>
      <strong class="readout-score-pct mono-stat" id="readout-confidence-pct">--%</strong>
    </div>

    <div class="readout-stats-row">
      <div class="stat-pill">
        <span class="stat-k">Sujeto:</span>
        <strong class="stat-v" id="readout-subject-gender">--</strong>
      </div>
      <div class="stat-pill">
        <span class="stat-k">Amenaza:</span>
        <strong class="stat-v" id="readout-threat-level">Bajo</strong>
      </div>
      <div class="stat-pill">
        <span class="stat-k">Latencia:</span>
        <strong class="stat-v mono-stat" id="readout-latency-ms">-- ms</strong>
      </div>
      <div class="stat-pill stat-hide">
        <span class="stat-k">Omitidos:</span>
        <strong class="stat-v mono-stat" id="readout-backpressure-stat">0</strong>
      </div>
    </div>

    <div class="readout-evidence-line">
      <span class="evidence-prefix">Evidencia:</span>
      <span class="evidence-body" id="readout-protocol-text">Conectando con el motor neuronal en localhost:8000...</span>
    </div>
  </div>

  <!-- Probabilidades por clase (7 clases) -->
  <section class="probabilities-section" aria-label="Distribución de probabilidades">
    <div class="section-subhead">
      <span class="subhead-title">Probabilidad de Escena</span>
      <span class="subhead-meta mono-stat">Softmax 1.00</span>
    </div>

    <div class="prob-bars-list">
      {CANONICAL_DETECTION_CLASSES.map((clsKey) => {
        const desc = DETECTION_CLASS_CATALOG[clsKey];
        const initialPct = clsKey === 'Escena_Normal' ? 95.0 : 0.8;
        return (
          <div class="prob-bar-item" data-prob-row={clsKey}>
            <div class="prob-bar-labels">
              <span class="prob-label-name">{desc.readableLabel}</span>
              <span class="prob-label-value mono-stat" data-prob-value={clsKey}>
                {initialPct.toFixed(1)}%
              </span>
            </div>
            <div class="prob-track">
              <div
                class="prob-fill"
                data-prob-fill={clsKey}
                style={`width: ${initialPct}%;`}
              ></div>
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <!-- Historial de alertas en vivo -->
  <section class="alerts-log-section" aria-label="Registro de alertas">
    <div class="section-subhead">
      <span class="subhead-title">Registro de Alertas</span>
      <button type="button" class="btn-clear-log" id="btn-clear-alerts" title="Limpiar historial">
        Limpiar
      </button>
    </div>

    <ul class="alerts-list" id="security-alert-log">
      <li class="alert-empty-state" id="alert-empty-item">
        Supervisión activa sin incidentes críticos. Las alertas aparecerán aquí de forma automática.
      </li>
    </ul>
  </section>
</aside>
