---
/**
 * Presentation Component: ModelTelemetryPanel.astro
 * Docked right-hand operational inspector for Camera 01 inference telemetry,
 * 7-class probability distribution, and chronological incident log.
 */
import { CANONICAL_DETECTION_CLASSES, DETECTION_CLASS_CATALOG } from '../domain';
---

<aside class="inspector-rail" aria-label="Inspector de detección y telemetría">
  <header class="inspector-section inspector-header">
    <div class="inspector-header-main">
      <h2 class="inspector-title">Análisis en vivo</h2>
      <span class="inspector-engine-meta" id="telemetry-model-name">Cámara 01</span>
    </div>
  </header>

  <section
    class="inspector-section readout-block"
    id="prediction-readout-card"
    data-threat-level="LOW"
    aria-label="Diagnóstico actual de Cámara 01"
  >
    <div class="readout-headline-row">
      <div class="readout-headline-text">
        <h3 class="readout-event-name" id="readout-readable-class">Iniciando monitoreo</h3>
        <span class="readout-key-tag mono-stat" id="readout-canonical-key">Escena_Normal</span>
      </div>
      <div class="readout-confidence-wrap">
        <strong class="readout-score-pct mono-stat" id="readout-confidence-pct">--%</strong>
        <span class="readout-score-caption">Confianza</span>
      </div>
    </div>

    <dl class="telemetry-kv-grid">
      <div class="kv-cell">
        <dt class="kv-label">Sujeto</dt>
        <dd class="kv-value" id="readout-subject-gender">Sin detectar</dd>
      </div>
      <div class="kv-cell">
        <dt class="kv-label">Nivel</dt>
        <dd class="kv-value" id="readout-threat-level">Bajo</dd>
      </div>
      <div class="kv-cell">
        <dt class="kv-label">Latencia</dt>
        <dd class="kv-value mono-stat" id="readout-latency-ms">-- ms</dd>
      </div>
      <div class="kv-cell">
        <dt class="kv-label">Omitidos</dt>
        <dd class="kv-value mono-stat" id="readout-backpressure-stat">0</dd>
      </div>
    </dl>

    <p class="readout-evidence-text" id="readout-protocol-text">
      Conectando con el servicio local en el puerto 8000.
    </p>
  </section>

  <section class="inspector-section probabilities-section" aria-label="Distribución de probabilidades por categoría">
    <div class="inspector-subhead">
      <h3 class="subhead-title">Distribución por categoría</h3>
      <span class="subhead-meta mono-stat">7 clases</span>
    </div>

    <div class="prob-bars-list">
      {CANONICAL_DETECTION_CLASSES.map((clsKey) => {
        const desc = DETECTION_CLASS_CATALOG[clsKey];
        const initialPct = clsKey === 'Escena_Normal' ? 95.0 : 0.8;
        const severityAttr = desc.defaultThreatLevel;
        return (
          <div
            class={`prob-bar-item${clsKey === 'Escena_Normal' ? ' prob-row-dominant' : ''}`}
            data-prob-row={clsKey}
            data-severity={severityAttr}
          >
            <div class="prob-bar-labels">
              <span class="prob-label-name" title={desc.readableLabel}>{desc.readableLabel}</span>
              <span class="prob-label-value mono-stat" data-prob-value={clsKey}>
                {initialPct.toFixed(1)}%
              </span>
            </div>
            <div class="prob-track">
              <div
                class="prob-fill"
                data-prob-fill={clsKey}
                style={`width: ${initialPct}%;`}
              ></div>
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <section class="inspector-section alerts-log-section" aria-label="Registro de alertas">
    <div class="inspector-subhead">
      <h3 class="subhead-title">Registro de incidentes</h3>
      <button type="button" class="btn-clear-log" id="btn-clear-alerts" title="Vaciar el historial de incidentes">
        Limpiar historial
      </button>
    </div>

    <ul class="alerts-list" id="security-alert-log">
      <li class="alert-empty-state" id="alert-empty-item">
        Sin incidentes registrados en esta sesión. Las alertas detectadas aparecerán aquí en orden cronológico.
      </li>
    </ul>
  </section>
</aside>
