---
/**
 * Presentation Component: DisabledServerCameraCard.astro
 * Compact, authentic CCTV monitor card for server camera nodes (CAM-02 through CAM-06).
 * Shows standby video feed placeholder, node ID, zone, and RTSP stream.
 */
import type { CameraNode } from '../domain';

export interface Props {
  node: CameraNode;
}

const { node } = Astro.props;
---

<article
  class="cctv-camera-card cctv-server-node"
  data-camera-id={node.camera_id}
  data-camera-status={node.status}
>
  <header class="cctv-card-header">
    <div class="cctv-id-tag">
      <span class="cctv-led cctv-led-standby" aria-hidden="true"></span>
      <span class="cctv-code">{node.camera_id}</span>
      <span class="cctv-zone-name">{node.location_zone}</span>
    </div>
    <span class="cctv-badge-standby">Servidor Standby</span>
  </header>

  <div class="cctv-viewport-box">
    <div class="cctv-screen-raster">
      <div class="cctv-scanline"></div>
      <div class="cctv-reticle-center">
        <span class="reticle-crosshair">+</span>
        <span class="cctv-standby-label">Canal en espera de enlace</span>
        <span class="cctv-rtsp-endpoint" data-endpoint-for={node.camera_id}>
          {node.stream_endpoint}
        </span>
      </div>
      <div class="cctv-screen-meta">
        <span class="cctv-resolution">{node.resolution}</span>
        <span class="cctv-fps-tag">0 FPS (Inactivo)</span>
      </div>
    </div>
  </div>

  <footer class="cctv-card-footer">
    <span class="cctv-status-note" data-reason-for={node.camera_id}>
      {node.status_reason}
    </span>
    <button
      type="button"
      class="btn-ping-node"
      data-verify-camera={node.camera_id}
      title="Comprobar conexión con el servidor central"
    >
      Verificar enlace
    </button>
  </footer>
</article>
