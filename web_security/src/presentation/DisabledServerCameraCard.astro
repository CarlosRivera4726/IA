---
/**
 * Presentation Component: DisabledServerCameraCard.astro
 * Represents one of the 5 remote server cameras (CAM-02 through CAM-06)
 * that communicate with the backend server and are temporarily disabled.
 */
import type { CameraNode } from '../domain';

export interface Props {
  node: CameraNode;
}

const { node } = Astro.props;
---

<article
  class="disabled-camera-card"
  data-camera-id={node.camera_id}
  data-camera-status={node.status}
  data-camera-active="false"
>
  <header class="disabled-card-header">
    <div class="disabled-id-group">
      <span class="status-led status-led-standby" aria-hidden="true"></span>
      <span class="camera-code">{node.camera_id}</span>
      <h4 class="disabled-camera-title">{node.location_zone}</h4>
    </div>
    <span class="operational-badge badge-disabled">Deshabilitada temporalmente</span>
  </header>

  <div class="disabled-viewport-placeholder">
    <div class="placeholder-reticle">
      <span class="placeholder-status-title">Canal de servidor en espera</span>
      <p class="placeholder-status-copy" data-reason-for={node.camera_id}>
        {node.status_reason}
      </p>
    </div>
  </div>

  <dl class="disabled-node-meta">
    <div class="meta-pair">
      <dt class="meta-term">Enlace de servidor</dt>
      <dd class="meta-detail mono-stat" data-endpoint-for={node.camera_id}>
        {node.stream_endpoint}
      </dd>
    </div>
    <div class="meta-pair">
      <dt class="meta-term">Modo de conexión</dt>
      <dd class="meta-detail">Nodo remoto gestionado por servidor (:8000)</dd>
    </div>
    <div class="meta-pair">
      <dt class="meta-term">Última consulta al servidor</dt>
      <dd class="meta-detail mono-stat" data-last-sync-for={node.camera_id}>
        Sincronizado al iniciar
      </dd>
    </div>
  </dl>

  <footer class="disabled-card-footer">
    <button
      type="button"
      class="btn-verify-node"
      data-verify-camera={node.camera_id}
    >
      Comprobar enlace con el servidor
    </button>
  </footer>
</article>
